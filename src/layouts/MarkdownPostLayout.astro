---
import { Icon } from 'astro-icon/components';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Comments from '../components/Comments.astro';
import { siteConfig } from '../config';
import { formatDate, posts, relatedPosts } from '../utils/posts';
import { withBase, withoutBase } from '../utils/url';

const { frontmatter, headings, url } = Astro.props as {
  frontmatter: Record<string, any>;
  headings: MarkdownHeading[];
  url: string;
};

const current = posts.find((post) => post.url === withoutBase(url));
const index = posts.findIndex((post) => post.url === withoutBase(url));
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index >= 0 && index < posts.length - 1 ? posts[index + 1] : undefined;

const toc = (headings ?? []).filter((heading) => heading.depth >= 2 && heading.depth <= 4);
const related = current ? relatedPosts(current, 3) : [];
---

<BaseLayout
  pageTitle={frontmatter.title}
  description={frontmatter.description}
  bannerTitle={frontmatter.title}
  bannerSubtitle={frontmatter.description}
  type="article"
>
  <article class="card p-5 md:p-7" data-pagefind-body>
    <header class="border-b border-divider pb-4">
      <h1 class="text-[1.45rem] font-bold leading-snug md:text-[1.8rem]">{frontmatter.title}</h1>

      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-[0.78rem] text-meta">
        <span class="inline-flex items-center gap-1">
          <Icon name="material-symbols:calendar-today-rounded" class="text-[1rem]" />
          {formatDate(new Date(frontmatter.pubDate))}
        </span>
        {
          frontmatter.updatedDate && (
            <span class="inline-flex items-center gap-1">
              <Icon name="material-symbols:history-rounded" class="text-[1rem]" />
              更新于 {formatDate(new Date(frontmatter.updatedDate))}
            </span>
          )
        }
        {
          frontmatter.category && (
            <span class="inline-flex items-center gap-1">
              <Icon name="material-symbols:folder-rounded" class="text-[1rem]" />
              {frontmatter.category}
            </span>
          )
        }
        {
          current && (
            <span class="inline-flex items-center gap-1">
              <Icon name="material-symbols:schedule-rounded" class="text-[1rem]" />
              {current.words} 字 · 约 {current.minutes} 分钟
            </span>
          )
        }
        {
          frontmatter.author && (
            <span class="inline-flex items-center gap-1">
              <Icon name="material-symbols:person-rounded" class="text-[1rem]" />
              {frontmatter.author}
            </span>
          )
        }
      </div>

      {
        frontmatter.tags?.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-1.5">
            {frontmatter.tags.map((tag: string) => (
              <a href={withBase(`/tags/${tag}/`)} class="chip">
                <Icon name="material-symbols:tag-outline-rounded" class="text-[0.8rem]" />
                {tag}
              </a>
            ))}
          </div>
        )
      }
    </header>

    {
      toc.length > 0 && (
        <details class="toc-mobile card mt-4 p-3 lg:hidden">
          <summary class="widget-title text-primary">
            <Icon name="material-symbols:toc-rounded" class="text-[1.15rem]" />
            目录
          </summary>
          <nav class="mt-2 flex flex-col gap-0.5">
            {toc.map((heading) => (
              <a
                href={`#${heading.slug}`}
                class="toc-link"
                style={`padding-left:${(heading.depth - 2) * 0.75 + 0.5}rem`}
              >
                {heading.text}
              </a>
            ))}
          </nav>
        </details>
      )
    }

    <div class="prose mt-6 max-w-none">
      <slot />
    </div>

    {
      frontmatter.image?.url && (
        <figure class="mt-6">
          <img
            src={withBase(frontmatter.image.url)}
            alt={frontmatter.image.alt}
            width="1200"
            height="800"
            class="w-full rounded-xl"
            loading="lazy"
          />
        </figure>
      )
    }

    {
      related.length > 0 && (
        <section class="mt-8 border-t border-divider pt-4">
          <div class="widget-title text-primary">
            <Icon name="material-symbols:article-rounded" class="text-[1.15rem]" />
            相关文章
          </div>
          <ul class="mt-3 flex flex-col gap-1.5">
            {related.map((post) => (
              <li>
                <a
                  href={withBase(post.url)}
                  class="btn-plain inline-flex items-center gap-2 px-2 py-1.5 text-[0.88rem]"
                >
                  <Icon name="material-symbols:article-outline-rounded" class="text-[1rem] text-primary" />
                  {post.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <footer class="mt-8 grid gap-3 border-t border-divider pt-4 text-[0.85rem] sm:grid-cols-2">
      {
        older ? (
          <a href={withBase(older.url)} class="card card-hover flex items-center gap-2 p-3">
            <Icon name="material-symbols:arrow-back-rounded" class="text-[1.1rem] text-primary" />
            <span class="min-w-0">
              <span class="block text-[0.72rem] text-meta">上一篇</span>
              <span class="block truncate">{older.title}</span>
            </span>
          </a>
        ) : (
          <span />
        )
      }
      {
        newer && (
          <a href={withBase(newer.url)} class="card card-hover flex items-center justify-end gap-2 p-3 text-right">
            <span class="min-w-0">
              <span class="block text-[0.72rem] text-meta">下一篇</span>
              <span class="block truncate">{newer.title}</span>
            </span>
            <Icon name="material-symbols:arrow-forward-rounded" class="text-[1.1rem] text-primary" />
          </a>
        )
      }
    </footer>
  </article>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: frontmatter.title,
      description: frontmatter.description,
      datePublished: new Date(frontmatter.pubDate).toISOString(),
      author: { '@type': 'Person', name: frontmatter.author ?? siteConfig.author },
      keywords: (frontmatter.tags ?? []).join(', '),
      inLanguage: siteConfig.lang,
      mainEntityOfPage: new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString(),
    })}
  />

  <Comments />

  <Fragment slot="right">
    {
      toc.length > 0 && (
        <div class="card mb-4 p-4">
          <div class="widget-title text-primary">
            <Icon name="material-symbols:toc-rounded" class="text-[1.2rem]" />
            目录
          </div>
          <nav class="mt-3 flex flex-col gap-0.5" id="toc">
            {toc.map((heading) => (
              <a
                href={`#${heading.slug}`}
                class="toc-link"
                style={`padding-left:${(heading.depth - 2) * 0.75 + 0.5}rem`}
              >
                {heading.text}
              </a>
            ))}
          </nav>
        </div>
      )
    }
  </Fragment>
</BaseLayout>

<script>
  // 目录滚动高亮（rAF 节流，减少重排）
  const links = Array.from(document.querySelectorAll('#toc .toc-link'));
  const targets = links
    .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
    .filter((el) => Boolean(el));

  if (targets.length > 0) {
    let activeIndex = -1;
    let ticking = false;
    const update = () => {
      ticking = false;
      const threshold = window.innerHeight * 0.2 + 60;
      let candidate = 0;
      targets.forEach((target, index) => {
        if (target.getBoundingClientRect().top <= threshold) candidate = index;
      });
      if (candidate === activeIndex) return;
      activeIndex = candidate;
      links.forEach((link, index) => link.classList.toggle('active', index === activeIndex));
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    update();
    document.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
</script>
