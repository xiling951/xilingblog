---
import { Icon } from 'astro-icon/components';
import { siteConfig } from '../config';

const comments = siteConfig.comments;
const enabled = comments.enable && comments.repoId && comments.categoryId;
---

{
  enabled && (
    <section class="card mt-4 p-4 md:p-6">
      <div class="widget-title text-primary">
        <Icon name="material-symbols:forum-rounded" class="text-[1.2rem]" />
        评论
      </div>
      <p class="mt-2 text-[0.78rem] text-meta">
        评论由 GitHub Discussions 驱动（giscus），需要登录 GitHub 账号。
      </p>
      <div class="mt-4">
        <script
          is:inline
          src="https://giscus.app/client.js"
          data-repo={comments.repo}
          data-repo-id={comments.repoId}
          data-category={comments.category}
          data-category-id={comments.categoryId}
          data-mapping={comments.mapping}
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme="preferred_color_scheme"
          data-lang="zh-CN"
          data-loading="lazy"
          crossorigin="anonymous"
          async
        ></script>
      </div>
    </section>
  )
}

<script>
  // giscus 配色要跟着站点开关走（而不只是跟系统偏好）
  const root = document.documentElement;
  const GISCUS_ORIGIN = 'https://giscus.app';
  const desiredTheme = () => (root.classList.contains('dark') ? 'dark' : 'light');

  // 就绪判据（确定性）：导航未提交时 iframe 是 about:blank（同源，能读到 location.origin=父页）→ 未就绪；
  // 已导航到 giscus.app（跨域，读取 location 抛异常）→ 就绪。
  const frameReady = (frame) => {
    try {
      return frame.contentWindow?.location.origin === GISCUS_ORIGIN;
    } catch {
      return true;
    }
  };

  const sendTheme = () => {
    const frame = document.querySelector('iframe.giscus-frame');
    if (!frame || !frame.contentWindow || !frameReady(frame)) return false;
    frame.contentWindow.postMessage({ giscus: { setConfig: { theme: desiredTheme() } } }, GISCUS_ORIGIN);
    return true;
  };

  // 轮询到就绪为止（400ms × 25 ≈ 10s）；判据确定，绝不会提前发送
  const syncWithRetry = (attempt = 0) => {
    if (sendTheme()) return;
    if (attempt < 25) window.setTimeout(() => syncWithRetry(attempt + 1), 400);
  };

  const attachToFrame = () => {
    const frame = document.querySelector('iframe.giscus-frame');
    if (!frame) return false;
    if (frame.dataset.themeHooked === '1') return true;
    frame.dataset.themeHooked = '1';
    frame.addEventListener('load', () => {
      frame.dataset.themeReady = '1';
      sendTheme();
    });
    return true;
  };

  // giscus 渲染完成后会向父页 postMessage（resizeHeight 等）。
  // 那才是「它已经应用过自己的初始主题」的信号：此时再发一次 setConfig 才不会被覆盖
  // （否则浅色站点 + 深色系统时，首次冷加载可能停在暗色，要点一次开关才正常）。
  let greeted = false;
  window.addEventListener('message', (event) => {
    if (event.origin !== GISCUS_ORIGIN) return;
    sendTheme();
    if (!greeted) {
      greeted = true;
      window.setTimeout(sendTheme, 600);
      window.setTimeout(sendTheme, 2000);
    }
  });

  new MutationObserver(() => {
    attachToFrame();
  }).observe(document.body, { childList: true, subtree: true });

  // 站点明暗切换时同步（帧未就绪由重试兜住）
  new MutationObserver(syncWithRetry).observe(root, {
    attributes: true,
    attributeFilter: ['class'],
  });

  window.addEventListener('load', () => {
    attachToFrame();
    syncWithRetry();
  });
  attachToFrame();
  syncWithRetry();
</script>
