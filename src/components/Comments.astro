---
import { Icon } from 'astro-icon/components';
import { siteConfig } from '../config';

const comments = siteConfig.comments;
const enabled = comments.enable && comments.repoId && comments.categoryId;
---

{
  enabled && (
    <section class="card mt-4 p-4 md:p-6">
      <div class="widget-title text-primary">
        <Icon name="material-symbols:forum-rounded" class="text-[1.2rem]" />
        评论
      </div>
      <p class="mt-2 text-[0.78rem] text-meta">
        评论由 GitHub Discussions 驱动（giscus），需要登录 GitHub 账号。
      </p>
      <div class="mt-4">
        <script
          is:inline
          src="https://giscus.app/client.js"
          data-repo={comments.repo}
          data-repo-id={comments.repoId}
          data-category={comments.category}
          data-category-id={comments.categoryId}
          data-mapping={comments.mapping}
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme="preferred_color_scheme"
          data-lang="zh-CN"
          data-loading="lazy"
          crossorigin="anonymous"
          async
        ></script>
      </div>
    </section>
  )
}

<script>
  // giscus 配色要跟着站点开关走（而不只是跟系统偏好）
  const root = document.documentElement;
  const GISCUS_ORIGIN = 'https://giscus.app';
  const desiredTheme = () => (root.classList.contains('dark') ? 'dark' : 'light');

  // 只有等 iframe 真正导航到 giscus.app 之后才能发消息：
  // 过早发送时接收窗口的 origin 还是父页，浏览器会丢弃消息并打印 targetOrigin 不匹配的警告
  const sendTheme = () => {
    const frame = document.querySelector('iframe.giscus-frame');
    if (!frame || frame.dataset.themeReady !== '1' || !frame.contentWindow) return false;
    frame.contentWindow.postMessage({ giscus: { setConfig: { theme: desiredTheme() } } }, GISCUS_ORIGIN);
    return true;
  };

  const syncWithRetry = (attempt = 0) => {
    if (sendTheme()) return;
    if (attempt < 8) window.setTimeout(() => syncWithRetry(attempt + 1), 400);
  };

  // giscus 是懒加载的：iframe 出现后绑 load；万一 load 已过（预渲染/懒加载竞态），1.2s 后补一次
  const attachToFrame = () => {
    const frame = document.querySelector('iframe.giscus-frame');
    if (!frame) return false;
    if (frame.dataset.themeHooked === '1') return true;
    frame.dataset.themeHooked = '1';

    const markReadyAndSync = () => {
      frame.dataset.themeReady = '1';
      sendTheme();
    };
    frame.addEventListener('load', markReadyAndSync);
    window.setTimeout(() => {
      if (frame.isConnected && frame.dataset.themeReady !== '1') markReadyAndSync();
    }, 1200);
    return true;
  };

  new MutationObserver(() => {
    attachToFrame();
  }).observe(document.body, { childList: true, subtree: true });

  // 站点明暗切换时同步（帧还没就绪就靠重试兜住，就绪后 markReadyAndSync 会补发当前主题）
  new MutationObserver(syncWithRetry).observe(root, {
    attributes: true,
    attributeFilter: ['class'],
  });

  window.addEventListener('load', () => {
    attachToFrame();
    syncWithRetry();
  });
  attachToFrame();
</script>
