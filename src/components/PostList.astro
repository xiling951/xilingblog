---
import { Icon } from 'astro-icon/components';
import { categories, type Post } from '../utils/posts';
import { withBase } from '../utils/url';
import PostCard from './PostCard.astro';

interface Props {
  posts: Post[];
  /** 是否显示顶部的分类入口（链接到分类页，和分页共存） */
  showFilter?: boolean;
}

const { posts, showFilter = true } = Astro.props;
---

{
  showFilter && (
    <div class="card mb-4 flex flex-wrap items-center gap-1.5 p-3">
      <a
        href={withBase('/blog/')}
        class="btn-plain flex items-center gap-1 bg-btn px-3 py-1.5 text-[0.82rem] font-semibold text-btn-content"
      >
        <Icon name="material-symbols:apps" class="text-[1rem]" />
        全部
      </a>
      <a
        href={withBase('/categories/')}
        class="btn-plain flex items-center gap-1 px-3 py-1.5 text-[0.82rem] text-plain"
      >
        <Icon name="material-symbols:folder-rounded" class="text-[1rem]" />
        分类
      </a>
      {categories.map((category) => (
        <a
          href={withBase(`/categories/${category.name}/`)}
          class="btn-plain flex items-center gap-1 px-3 py-1.5 text-[0.82rem] text-plain"
        >
          {category.name}
          <span class="opacity-60">{category.count}</span>
        </a>
      ))}
    </div>
  )
}

<div id="post-list" class="flex flex-col gap-4">
  {posts.map((post) => <PostCard post={post} />)}
</div>
