---
import { Icon } from 'astro-icon/components';
import { siteConfig } from '../config';
import { categories, relativeDays, siteStats } from '../utils/posts';

/** 站点统计 */
const stats = [
  { icon: 'material-symbols:article-rounded', label: '文章', value: String(siteStats.postCount) },
  { icon: 'material-symbols:category-rounded', label: '分类', value: String(siteStats.categoryCount) },
  { icon: 'material-symbols:tag-rounded', label: '标签', value: String(siteStats.tagCount) },
  {
    icon: 'material-symbols:format-letter-spacing-rounded',
    label: '总字数',
    value: siteStats.totalWords.toLocaleString('en-US'),
  },
  {
    icon: 'material-symbols:history-rounded',
    label: '运行天数',
    value: String(
      Math.max(
        1,
        Math.floor((Date.now() - new Date(siteConfig.footer.startDate).valueOf()) / 86_400_000)
      )
    ),
  },
  {
    icon: 'material-symbols:bolt-rounded',
    label: '最近更新',
    value: relativeDays(siteStats.lastActivity),
  },
];

/** 当前月份的日历 */
const now = new Date();
const year = now.getFullYear();
const month = now.getMonth();
const monthLabel = `${year} 年 ${month + 1} 月`;
const firstWeekday = new Date(year, month, 1).getDay();
const daysInMonth = new Date(year, month + 1, 0).getDate();
const cells: (number | null)[] = [
  ...Array.from({ length: firstWeekday }, () => null),
  ...Array.from({ length: daysInMonth }, (_, i) => i + 1),
];
const weekdayLabels = ['日', '一', '二', '三', '四', '五', '六'];
---

<aside class="flex w-full flex-col gap-4">
  <!-- 站点统计 -->
  <div class="card onload-animation p-4">
    <div class="widget-title text-primary">
      <Icon name="material-symbols:analytics-rounded" class="text-[1.2rem]" />
      站点统计
    </div>
    <div class="mt-3 flex flex-col gap-1.5">
      {
        stats.map((item) => (
          <div class="flex items-center gap-2 rounded-lg px-2 py-1.5 text-[0.85rem] transition-colors hover:bg-btn">
            <Icon name={item.icon} class="text-[1.05rem] text-btn-content" />
            <span class="text-meta">{item.label}</span>
            <span class="ml-auto font-semibold">{item.value}</span>
          </div>
        ))
      }
    </div>
  </div>

  <!-- 日历 -->
  <div class="card onload-animation p-4">
    <div class="widget-title text-primary">
      <Icon name="material-symbols:calendar-month-rounded" class="text-[1.2rem]" />
      {monthLabel}
    </div>
    <div class="mt-3 grid grid-cols-7 gap-1 text-center text-[0.72rem] text-meta">
      {weekdayLabels.map((day) => <div class="py-1">{day}</div>)}
      {
        cells.map((day) => (
          <div
            class:list={[
              'flex h-7 items-center justify-center rounded-lg text-[0.78rem]',
              day === null ? '' : 'hover:bg-btn',
              day === now.getDate() ? 'bg-primary font-bold text-white' : 'text-plain',
            ]}
          >
            {day ?? ''}
          </div>
        ))
      }
    </div>
  </div>

  <!-- 分类 -->
  <div class="card onload-animation p-4">
    <div class="widget-title text-primary">
      <Icon name="material-symbols:folder-rounded" class="text-[1.2rem]" />
      分类
    </div>
    <div class="mt-3 flex flex-col gap-1">
      {
        categories.map((category) => (
          <div class="flex items-center gap-2 rounded-lg px-2 py-1.5 text-[0.85rem] transition-colors hover:bg-btn">
            <Icon name="material-symbols:folder-open-rounded" class="text-[1.05rem] text-btn-content" />
            <span>{category.name}</span>
            <span class="ml-auto text-meta">{category.count}</span>
          </div>
        ))
      }
    </div>
  </div>
</aside>
