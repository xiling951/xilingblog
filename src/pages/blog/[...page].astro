---
import Pagination from '../../components/Pagination.astro';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config';
import { posts } from '../../utils/posts';

export async function getStaticPaths({ paginate }) {
  // 注意：getStaticPaths 会被提升到独立作用域，不能用本文件里定义的外层常量（用 import 进来的配置没问题）
  return paginate(posts, { pageSize: siteConfig.postsPerPage });
}

const { page } = Astro.props;
const pageTitle = page.currentPage === 1 ? '归档' : `归档 · 第 ${page.currentPage} 页`;
---

<BaseLayout
  pageTitle={pageTitle}
  bannerTitle="归档"
  bannerSubtitle={`共 ${posts.length} 篇文章 · 第 ${page.currentPage} / ${page.lastPage} 页`}
>
  <PostList posts={page.data} />
  <Pagination currentPage={page.currentPage} lastPage={page.lastPage} />
</BaseLayout>
