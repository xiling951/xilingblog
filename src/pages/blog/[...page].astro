---
import Pagination from '../../components/Pagination.astro';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config';
import { posts } from '../../utils/posts';
import { withBase } from '../../utils/url';

export async function getStaticPaths({ paginate }) {
  // 注意：getStaticPaths 会被提升到独立作用域，不能用本文件里定义的外层常量（用 import 进来的配置没问题）
  return paginate(posts, { pageSize: siteConfig.postsPerPage });
}

const { page } = Astro.props;

// 分页页面的上一页/下一页（给 <link rel="prev/next"> 用）
const pageHref = (n: number) => (n === 1 ? withBase('/blog/') : withBase(`/blog/${n}/`));
const prevUrl = page.currentPage > 1 ? pageHref(page.currentPage - 1) : undefined;
const nextUrl = page.currentPage < page.lastPage ? pageHref(page.currentPage + 1) : undefined;
const pageTitle = page.currentPage === 1 ? '归档' : `归档 · 第 ${page.currentPage} 页`;
---

<BaseLayout
  pageTitle={pageTitle}
  bannerTitle="归档"
  bannerSubtitle={`共 ${posts.length} 篇文章 · 第 ${page.currentPage} / ${page.lastPage} 页`}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
>
  <PostList posts={page.data} />
  <Pagination currentPage={page.currentPage} lastPage={page.lastPage} />
</BaseLayout>
