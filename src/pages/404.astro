---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { posts } from '../utils/posts';
import { withBase } from '../utils/url';

const pageTitle = '页面走丢了';
const latest = posts.slice(0, 3);
---

<BaseLayout pageTitle={pageTitle} bannerTitle="404" bannerSubtitle="这个页面走丢了">
  <div class="card p-6 text-center md:p-10">
    <Icon name="material-symbols:explore-off-rounded" class="text-[3rem] text-primary" />
    <h2 class="mt-3 text-[1.3rem] font-bold">没找到这个页面</h2>
    <p class="mt-2 text-[0.9rem] text-meta">
      可能是链接写错了，或者这篇文章还没写。可以回首页，或者从下面的最新文章里挑一篇看看。
    </p>
    <div class="mt-5 flex flex-wrap items-center justify-center gap-2">
      <a href={withBase('/')} class="btn-regular inline-flex items-center gap-1 px-4 py-2 text-[0.88rem]">
        <Icon name="material-symbols:home-rounded" class="text-[1.1rem]" />
        回首页
      </a>
      <a href={withBase('/blog/')} class="btn-plain inline-flex items-center gap-1 px-4 py-2 text-[0.88rem] text-btn-content">
        <Icon name="material-symbols:archive-rounded" class="text-[1.1rem]" />
        看归档
      </a>
    </div>

    {
      latest.length > 0 && (
        <div class="mt-6 border-t border-divider pt-4 text-left">
          <p class="text-[0.82rem] text-meta">最新文章</p>
          <ul class="mt-2 flex flex-col gap-1.5">
            {latest.map((post) => (
              <li>
                <a href={withBase(post.url)} class="btn-plain inline-flex items-center gap-2 px-2 py-1.5 text-[0.88rem]">
                  <Icon name="material-symbols:article-outline-rounded" class="text-[1rem] text-primary" />
                  {post.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</BaseLayout>
