---
import { Icon } from 'astro-icon/components';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories, posts } from '../../utils/posts';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.name },
    props: { categoryPosts: posts.filter((post) => post.category === category.name) },
  }));
}

const { category } = Astro.params;
const { categoryPosts } = Astro.props;
---

<BaseLayout
  pageTitle={`分类：${category}`}
  description={`分类「${category}」下的文章，共 ${categoryPosts.length} 篇。`}
  bannerTitle={category}
  bannerSubtitle={`共 ${categoryPosts.length} 篇文章`}
>
  <div class="card mb-4 flex flex-wrap items-center gap-2 p-4">
    <Icon name="material-symbols:folder-rounded" class="text-[1.3rem] text-primary" />
    <span class="text-[0.95rem]">
      分类「<span class="font-semibold text-btn-content">{category}</span>」下的文章
    </span>
    <a
      href={withBase('/categories/')}
      class="btn-plain ml-auto px-3 py-1.5 text-[0.8rem] text-btn-content"
    >
      全部分类
    </a>
  </div>

  <PostList posts={categoryPosts} showFilter={false} />
</BaseLayout>
