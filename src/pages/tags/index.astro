---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts, tagCounts } from '../../utils/posts';
import { withBase } from '../../utils/url';

const pageTitle = '标签';
const maxCount = Math.max(...tagCounts.map((tag) => tag.count), 1);
const sizeOf = (count: number) => (count >= maxCount ? '1rem' : count > 1 ? '0.9rem' : '0.82rem');
---

<BaseLayout pageTitle={pageTitle} bannerTitle={pageTitle} bannerSubtitle={`共 ${tagCounts.length} 个标签 · ${posts.length} 篇文章`}>
  <div class="card p-5 md:p-7">
    <div class="widget-title text-primary">
      <Icon name="material-symbols:tag-rounded" class="text-[1.3rem]" />
      全部标签
    </div>
    <div class="mt-4 flex flex-wrap gap-2">
      {
        tagCounts.map((tag) => (
          <a
            href={withBase(`/tags/${tag.name}/`)}
            class="chip"
            style={`font-size:${sizeOf(tag.count)}`}
          >
            <Icon name="material-symbols:tag-outline-rounded" class="text-[0.85em]" />
            {tag.name}
            <span class="opacity-60">{tag.count}</span>
          </a>
        ))
      }
    </div>
  </div>

  <div class="card mt-4 p-5 md:p-7">
    <div class="widget-title text-primary">
      <Icon name="material-symbols:folder-rounded" class="text-[1.3rem]" />
      按分类浏览
    </div>
    <div class="mt-4">
      <a href={withBase('/blog/')} class="btn-regular inline-flex items-center gap-1 px-3 py-1.5 text-[0.85rem]">
        <Icon name="material-symbols:archive-rounded" class="text-[1.05rem]" />
        去归档页按分类筛选
      </a>
    </div>
  </div>
</BaseLayout>
