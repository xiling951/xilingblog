---
import { Icon } from 'astro-icon/components';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts, tagCounts } from '../../utils/posts';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  return tagCounts.map((tag) => ({
    params: { tag: tag.name },
    props: { tagPosts: posts.filter((post) => post.tags.includes(tag.name)) },
  }));
}

const { tag } = Astro.params;
const { tagPosts } = Astro.props;
---

<BaseLayout
  pageTitle={`标签：${tag}`}
  description={`标签「${tag}」下的文章，共 ${tagPosts.length} 篇。`}
  bannerTitle={`#${tag}`}
  bannerSubtitle={`共 ${tagPosts.length} 篇文章`}
>
  <div class="card mb-4 flex items-center gap-2 p-4">
    <Icon name="material-symbols:tag-rounded" class="text-[1.3rem] text-primary" />
    <span class="text-[0.95rem]">
      包含「<span class="font-semibold text-btn-content">{tag}</span>」标签的文章
    </span>
    <a href={withBase('/tags/')} class="btn-plain ml-auto px-3 py-1.5 text-[0.8rem] text-btn-content">
      全部标签
    </a>
  </div>

  <PostList posts={tagPosts} showFilter={false} />
</BaseLayout>
